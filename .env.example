# Copy to .env and fill in. Never commit .env.

# PayPal sandbox: https://developer.paypal.com/dashboard/ -> Apps & Credentials (Sandbox)
# The app must be linked to a US business account, with Payouts, Invoicing,
# Transaction search and Expanded checkout enabled.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# AI: OpenRouter (https://openrouter.ai/keys). Free models; the app falls back in order.
OPENROUTER_API_KEY=your_openrouter_key
AI_MODEL=minimax/minimax-m3.1-flash:free
AI_MODEL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
AI_MODEL_FALLBACK_2=google/gemma-4-31b-it:free

# App
DATABASE_URL=postgres://localhost:5432/milestone
APP_URL=http://localhost:3000
# Platform fee in basis points (500 = 5%). Payout = captured amount minus this fee.
PLATFORM_FEE_BPS=500
# Payouts fee estimate taken from the worker's share (PayPal US: 2% capped at $1.00). Empty cap = no cap.
PAYOUT_FEE_BPS=200
PAYOUT_FEE_CAP_CENTS=100
# 1 enables forced PayPal errors (PayPal-Mock-Response) for local testing. Never set in production.
ALLOW_DEV_ACTIONS=0
# Set after registering the webhook (scripts/register-webhook.sh prints it). Not a secret.
PAYPAL_WEBHOOK_ID=
# Secret key for hashing caller IPs in the rate-limit table (any long random string, e.g. openssl rand -hex 32).
# Optional: unset, a fixed prefix is used instead.
RATE_LIMIT_SALT=
