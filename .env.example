# Copy to .env and fill in. Never commit .env.

# PayPal sandbox: https://developer.paypal.com/dashboard/ -> Apps & Credentials (Sandbox)
# The app must be linked to a US business account, with Payouts, Invoicing,
# Transaction search and Expanded checkout enabled.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# AI: OpenRouter (https://openrouter.ai/keys). Free models; the app falls back in order.
OPENROUTER_API_KEY=your_openrouter_key
AI_MODEL=dots-studio/dots-3-note-preview:free
AI_MODEL_FALLBACK=nvidia/nemotron-3.5-super-vl:free
AI_MODEL_FALLBACK_2=recursive/flint-v1.0:free
# Trusted runner (E3): a fine-grained token with Actions: read and write on TanmayShah29/milestone-runner only.
# Unset, reviews use the PR's own CI (E2).
RUNNER_GITHUB_TOKEN=
# Resolution desk (src/lib/resolution/). All three set: new terms name this arbitrator, and either side can
# lock a decision for them. Make the key with `npx tsx scripts/sign-award.mts keygen <file>`; only the public
# key goes here.
ARBITRATOR_NAME=Milestone Resolution Desk
ARBITRATOR_PUBLIC_JWK=
ARBITRATOR_PAYPAL_EMAIL=
# Each side's fee hold to lock or match, in cents (default 500 = $5).
RESOLUTION_FEE_CENTS=500
# Models on the review panel (policy-2): 3, or 2 to save calls (a tie then goes to a person).
AI_PANEL_SIZE=3

# App
DATABASE_URL=postgres://localhost:5432/milestone
APP_URL=http://localhost:3000
# Platform fee in basis points (500 = 5%). Payout = captured amount minus this fee.
PLATFORM_FEE_BPS=500
# Payouts fee estimate taken from the worker's share (PayPal US: 2% capped at $1.00). Empty cap = no cap.
PAYOUT_FEE_BPS=200
PAYOUT_FEE_CAP_CENTS=100
# 1 enables the dev-only "mark review passed" route and forced PayPal errors. Never set in production.
# ALLOW_DEV_ACTIONS=1  # local dev only: forced PayPal errors (PayPal-Mock-Response); leave unset in production
# Set after registering the webhook (scripts/register-webhook.sh prints it). Not a secret.
PAYPAL_WEBHOOK_ID=
# Secret key for hashing caller IPs in the rate-limit table (any long random string, e.g. openssl rand -hex 32).
# Optional: unset, a fixed prefix is used instead.
RATE_LIMIT_SALT=
# Proof-chain signing key: base64 PKCS#8 of an ECDSA P-256 private key. Generate one with
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
# Optional: unset, the app generates a key on first use and keeps it in the database (labelled "generated").
PROOF_SIGNING_KEY=

# GitHub: a fine-grained token with Pull requests read/write on the demo repo (comments, PR reads)
GITHUB_TOKEN=
# AI calls per day across the app (free OpenRouter limit is 50/day)
AI_DAILY_CAP=40
# Review clocks in seconds: objection window (120 = demo; 172800 = 48 h for real use) and post-objection release (72 h)
OBJECTION_WINDOW_SECONDS=120
OBJECTION_RELEASE_SECONDS=259200
